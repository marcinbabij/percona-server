INSTALL PLUGIN clone SONAME 'CLONE_PLUGIN';
CREATE TABLE clone_r (id INT PRIMARY KEY) ENGINE=RocksDB;
CREATE TABLE clone_i (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO clone_r VALUES (7);
INSERT INTO clone_i VALUES (7);
INSTALL PLUGIN clone SONAME 'CLONE_PLUGIN';
SET GLOBAL clone_autotune_concurrency = OFF;
SET GLOBAL clone_max_concurrency = 1;
SET GLOBAL clone_valid_donor_list = '127.0.0.1:PORT';
SET GLOBAL DEBUG = '+d,clone_recovery_crash_point';
CLONE INSTANCE FROM 'root'@'127.0.0.1':PORT IDENTIFIED BY '';
# restart_abort: 
# restart
include/assert_grep.inc [InnoDB recovery of the cloned data failed]
include/assert_grep.inc [MyRocks discarded the uncommitted stage]
SELECT TABLE_SCHEMA, TABLE_NAME FROM information_schema.tables
WHERE TABLE_NAME IN ('clone_r', 'clone_i');
TABLE_SCHEMA	TABLE_NAME
SET GLOBAL clone_autotune_concurrency = OFF;
SET GLOBAL clone_max_concurrency = 1;
SET GLOBAL clone_valid_donor_list = '127.0.0.1:PORT';
CLONE INSTANCE FROM 'root'@'127.0.0.1':PORT IDENTIFIED BY '';
# restart
