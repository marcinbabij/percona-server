INSTALL PLUGIN clone SONAME 'CLONE_PLUGIN';
CREATE TABLE clone_r (id INT PRIMARY KEY) ENGINE=RocksDB;
CREATE TABLE clone_i (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO clone_r VALUES (7);
INSERT INTO clone_i VALUES (7);
INSTALL PLUGIN clone SONAME 'CLONE_PLUGIN';
CREATE TABLE old_recipient (id INT PRIMARY KEY) ENGINE=RocksDB;
INSERT INTO old_recipient VALUES (99);
SET GLOBAL clone_autotune_concurrency = OFF;
SET GLOBAL clone_max_concurrency = 2;
SET GLOBAL clone_valid_donor_list = '127.0.0.1:PORT';
CLONE INSTANCE FROM 'root'@'127.0.0.1':PORT IDENTIFIED BY '';
# restart:
USE test;
SELECT * FROM clone_i;
id
7
SELECT id FROM clone_r ORDER BY id;
id
7
include/assert.inc [Provisioning must open the donor's column families and retain its rows]
include/assert.inc [Provisioning must remove the recipient's old tables]
DROP TABLE clone_i, clone_r;
UNINSTALL PLUGIN clone;
DROP TABLE clone_i, clone_r;
UNINSTALL PLUGIN clone;
