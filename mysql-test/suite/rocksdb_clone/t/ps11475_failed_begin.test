# A normal provisioning error must not leave an installable RocksDB stage.
--source include/have_rocksdb.inc
--let $port = `SELECT @@port`
--replace_result $CLONE_PLUGIN CLONE_PLUGIN
--eval INSTALL PLUGIN clone SONAME '$CLONE_PLUGIN'
CREATE TABLE clone_r (id INT PRIMARY KEY) ENGINE=RocksDB;
INSERT INTO clone_r VALUES (7);
--connect (recipient,127.0.0.1,root,,test,$SERVER_PORT_2)
--replace_result $CLONE_PLUGIN CLONE_PLUGIN
--eval INSTALL PLUGIN clone SONAME '$CLONE_PLUGIN'
CREATE DATABASE protected_schema;
CREATE TABLE protected_schema.keep_r (id INT PRIMARY KEY) ENGINE=RocksDB;
INSERT INTO protected_schema.keep_r VALUES (99);
ALTER DATABASE protected_schema READ ONLY=1;
--disable_query_log
CALL mtr.add_suppression('Clone removing all user data for provisioning');
CALL mtr.add_suppression('Clone failed to execute');
--enable_query_log
# Preserve MTR bookkeeping when provisioning rejects the read-only schema.
ALTER DATABASE mtr READ ONLY=1;
SET GLOBAL clone_autotune_concurrency = OFF;
SET GLOBAL clone_max_concurrency = 1;
--replace_result $port PORT
--eval SET GLOBAL clone_valid_donor_list = '127.0.0.1:$port'
--replace_result $port PORT
--error ER_SCHEMA_READ_ONLY
--eval CLONE INSTANCE FROM 'root'@'127.0.0.1':$port IDENTIFIED BY ''
ALTER DATABASE mtr READ ONLY=0;
SELECT * FROM protected_schema.keep_r;
--let $restart_parameters = restart:
--source include/restart_mysqld.inc
SELECT * FROM protected_schema.keep_r;
--let $assert_text = A failed clone must not replace the RocksDB database at restart
--let $assert_cond = `SELECT COUNT(*)=1 FROM protected_schema.keep_r WHERE id=99`
--source include/assert.inc
ALTER DATABASE protected_schema READ ONLY=0;
DROP DATABASE protected_schema;
UNINSTALL PLUGIN clone;
--disconnect recipient
--connection default
DROP TABLE clone_r;
UNINSTALL PLUGIN clone;
