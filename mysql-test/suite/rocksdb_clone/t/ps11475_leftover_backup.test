# The old RocksDB database kept by an installed provisioning clone is
# destroyed after the received one opened. If it holds a file which
# RocksDB did not create, its directory survives. The server must keep
# running, and reject a new provisioning clone until it is removed.
--source include/have_rocksdb.inc
--let $port = `SELECT @@port`
--source ../include/ps11475_suppress.inc
--disable_query_log
CALL mtr.add_suppression('RocksDB clone: cannot remove .*_clone_old');
--enable_query_log
--replace_result $CLONE_PLUGIN CLONE_PLUGIN
--eval INSTALL PLUGIN clone SONAME '$CLONE_PLUGIN'
CREATE TABLE clone_r (id INT PRIMARY KEY) ENGINE=RocksDB;
INSERT INTO clone_r VALUES (7);
--connect (recipient,127.0.0.1,root,,test,$SERVER_PORT_2)
--source ../include/ps11475_suppress.inc
--disable_query_log
CALL mtr.add_suppression('RocksDB clone: cannot remove .*_clone_old');
--enable_query_log
--replace_result $CLONE_PLUGIN CLONE_PLUGIN
--eval INSTALL PLUGIN clone SONAME '$CLONE_PLUGIN'
--let $live = `SELECT CONCAT(@@datadir, @@rocksdb_datadir)`
--let $backup = `SELECT CONCAT(@@datadir, @@rocksdb_datadir, '_clone_old')`
# A directory of an operator in the old database directory.
--mkdir $live/operator_notes
SET GLOBAL clone_autotune_concurrency = OFF;
SET GLOBAL clone_max_concurrency = 1;
--replace_result $port PORT
--eval SET GLOBAL clone_valid_donor_list = '127.0.0.1:$port'
--source include/expect_crash.inc
--replace_result $port PORT
--error 0,ER_RESTART_SERVER_FAILED,CR_SERVER_LOST,CR_SERVER_GONE_ERROR
--eval CLONE INSTANCE FROM 'root'@'127.0.0.1':$port IDENTIFIED BY ''
--source include/wait_until_disconnected.inc
--let $restart_parameters = restart:
--source include/start_mysqld.inc
USE test;
SELECT id FROM clone_r ORDER BY id;
--file_exists $backup/operator_notes
--let $assert_text = The leftover backup is reported at startup
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select = RocksDB clone: cannot remove .*_clone_old
--let $assert_count = 1
--let $assert_only_after = CURRENT_TEST: rocksdb_clone.ps11475_leftover_backup
--source include/assert_grep.inc
# Reject provisioning before any user data is dropped.
--replace_result $port PORT
--eval SET GLOBAL clone_valid_donor_list = '127.0.0.1:$port'
--replace_result $port PORT $backup BACKUP
--error ER_FILE_EXISTS_ERROR
--eval CLONE INSTANCE FROM 'root'@'127.0.0.1':$port IDENTIFIED BY ''
SELECT id FROM clone_r ORDER BY id;
--force-rmdir $backup
DROP TABLE clone_r;
UNINSTALL PLUGIN clone;
--disconnect recipient
--connection default
DROP TABLE clone_r;
UNINSTALL PLUGIN clone;
